AppService connection to the SmartAppearance package.</summary>\n        /// <returns>connection on success, null on failure</returns>\n        private static AppServiceConnection OpenAsync()\n        {\n            var conn = new AppServiceConnection();\n            conn.AppServiceName   = AppServiceName;\n            conn.PackageFamilyName = PackageFamilyName;\n\n            Task<AppServiceConnectionStatus> task = conn.OpenAsync().AsTask();\n            if (!task.Wait(TimeoutMs))            // WaitHandle.Wait -> timeout\n                return null;                      // -> STATUS_SET_TIMEOUT\n            if (task.Result != AppServiceConnectionStatus.Success)  // op_Equality\n                return null;                      // -> STATUS_CONNECT_SVR_ERR\n            return conn;\n        }\n\n        /// <summary>Sends the ToggleBlurSwitch command and maps the reply to a status code.</summary>\n        private static int SendMessageAsync(AppServiceConnection conn)\n        {\n            var message = new ValueSet();\n            message.Add(RequestKey, RequestCommand);      // { \"Key\" : \"ToggleBlurSwitch\" }\n\n            Task<AppServiceResponse> task = conn.SendMessageAsync(message).AsTask();\n            if (!task.Wait(TimeoutMs))\n                return STATUS_SET_TIMEOUT;\n\n            AppServiceResponse response = task.Result;\n            if (response.Status != AppServiceResponseStatus.Success)   // get_Status\n                return STATUS_SVR_REPOND_ERR;\n\n            if (!response.Message.ContainsKey(ResultKey))               // get_Message/ContainsKey\n                return STATUS_RETURN_ERR;\n\n            string result = response.Message[ResultKey].ToString();     // get_Item / Object.ToString()\n            if (string.IsNullOrEmpty(result))                           // IsNullOrEmpty\n                return STATUS_RETURN_ERR;\n\n            if (result == ResultBlurOn)      return STATUS_SET_BLUR_ON_OK;   // String.op_Equality\n            if (result == ResultBlurOff)     return STATUS_SET_BLUR_OFF_OK;\n            if (result == ResultBlurError)   return STATUS_SET_FEATURE_ERR;\n            return STATUS_RETURN_ERR;\n        }\n\n        /// <summary>Toggles the camera background-blur state. Entry point.</summary>\n        /// <returns>STATUS_* code (logged by the caller as \"retBlur=%d\")</returns>\n        public static int ToggleBlurSwitch()\n        {\n            try\n            {\n                AppServiceConnection conn = OpenAsync();\n                if (conn == null)\n                    return STATUS_CONNECT_SVR_ERR;\n\n                using (conn)                                  // IDisposable.Dispose\n                {\n                    return SendMessageAsync(conn);\n                }\n            }\n            catch (Exception)                                 // STATUS_EXCEPTION\n            {\n                return STATUS_EXCEPTION;\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n//  Assembly attributes (verbatim from metadata)\n// ---------------------------------------------------------------------------\n[assembly: Guid(\"a8bf1931-bcd8-4ccb-b8b6-b75b2f620041\")]\n[assembly: System.Runtime.InteropServices.ComVisible(false)]\n[assembly: System.Diagnostics.Debuggable(System.Diagnostics.DebuggingModes.WrapNonExceptionThrows)]\n[assembly: System.Runtime.CompilerServices.CompilationRelaxations(System.Runtime.CompilerServices.CompilationRelaxations.NoStringInterning)]\n[assembly: System.Runtime.Versioning.TargetFramework(\".NETFramework,Version=v4.6.1\", FrameworkDisplayName = \".NET Framework 4.6.1\")]\n[assembly: System.Reflection.AssemblyTitle(\"BlurSwitchCS\")]\n[assembly: System.Reflection.AssemblyProduct(\"BlurSwitchCS\")]\n[assembly: System.Reflection.AssemblyCompany(\"Lenovo\")]\n[assembly: System.Reflection.AssemblyCopyright(\"Copyright \\u00a9  2021\")]\n[assembly: System.Reflection.AssemblyFileVersion(\"1