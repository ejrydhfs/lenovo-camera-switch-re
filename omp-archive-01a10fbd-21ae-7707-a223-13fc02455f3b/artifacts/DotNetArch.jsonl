  return STATUS_SET_BLUR_OFF_OK;\\n            if (result == ResultBlurError)   return STATUS_SET_FEATURE_ERR;\\n            return STATUS_RETURN_ERR;\\n        }\\n\\n        /// <summary>Toggles the camera background-blur state. Entry point.</summary>\\n        /// <returns>STATUS_* code (logged by the caller as \\\"retBlur=%d\\\")</returns>\\n        public static int ToggleBlurSwitch()\\n        {\\n            try\\n            {\\n                AppServiceConnection conn = OpenAsync();\\n                if (conn == null)\\n                    return STATUS_CONNECT_SVR_ERR;\\n\\n                using (conn)                                  // IDisposable.Dispose\\n                {\\n                    return SendMessageAsync(conn);\\n                }\\n            }\\n            catch (Exception)                                 // STATUS_EXCEPTION\\n            {\\n                return STATUS_EXCEPTION;\\n            }\\n        }\\n    }\\n}\\n\\n// ---------------------------------------------------------------------------\\n//  Assembly attributes (verbatim from metadata)\\n// ---------------------------------------------------------------------------\\n[assembly: Guid(\\\"a8bf1931-bcd8-4ccb-b8b6-b75b2f620041\\\")]\\n[assembly: System.Runtime.InteropServices.ComVisible(false)]\\n[assembly: System.Diagnostics.Debuggable(System.Diagnostics.DebuggingModes.WrapNonExceptionThrows)]\\n[assembly: System.Runtime.CompilerServices.CompilationRelaxations(System.Runtime.CompilerServices.CompilationRelaxations.NoStringInterning)]\\n[assembly: System.Runtime.Versioning.TargetFramework(\\\".NETFramework,Version=v4.6.1\\\", FrameworkDisplayName = \\\".NET Framework 4.6.1\\\")]\\n[assembly: System.Reflection.AssemblyTitle(\\\"BlurSwitchCS\\\")]\\n[assembly: System.Reflection.AssemblyProduct(\\\"BlurSwitchCS\\\")]\\n[assembly: System.Reflection.AssemblyCompany(\\\"Lenovo\\\")]\\n[assembly: System.Reflection.AssemblyCopyright(\\\"Copyright \\\\u00a9  2021\\\")]\\n[assem