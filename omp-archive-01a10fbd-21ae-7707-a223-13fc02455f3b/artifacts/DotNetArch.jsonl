uage>\n\n    <!--   Portugese (Brazil) --> \n    <language code=\"0x0416\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Bem-vindo ao assistente de instalação de driver de dispositivo.</welcomeTitle>\n      <welcomeIntro>Este assistente orienta você por todo o processo de instalação do software de driver de dispositivo necessário para habilitar totalmente as funções do dispositivo de hardware.</welcomeIntro>\n      <installHeaderTitle>Instalando o software para o dispositivo de hardware...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Concluindo o assistente de instalação do driver de dispositivo</finishTitle>\n\t  <finishText>Parabéns! Você concluiu a instalação dos drivers de dispositivo.</finishText>\n    </language>\n\n    <!--  Bulgarian --> \n    <language code=\"0x0402\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Добре дошли в съветите за инсталиране на драйвери на устройства.</welcomeTitle>\n      <welcomeIntro>Настоящите съвети ще осигурят напътствия в процеса на инсталиране на софтуерния драйвер на устройството, необходим за пълното активиране на хардуера му.</welcomeIntro>\n      <installHeaderTitle>Инсталиране на софтуер за хардуерно устройство...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Край на съветите за инсталиране на драйвери на устройства</finishTitle>\n\t  <finishText>Поздравления! Инсталирането на драйвери на устройства завърши.</finishText>\n    </language>\n\n    <!-- Croatian -->\n    <language code=\"0x041a\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Dobrodošli u čarobnjak za instaliranje upravljačkog programa uređaja.</welcomeTitle>\n      <welcomeIntro>Ovaj vam čarobnjak pomaže pri postupku instaliranja softvera upravljačkog programa uređaja koji je potreban kako bi se u potpunosti omogućile funkcije vašeg hardverskog uređaja.</welcomeIntro>\n      <installHeaderTitle>Instalacija softvera za vaš hardverski uređaj...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Dovršavanje čarobnjaka za instaliranje upravljačkog programa uređaja</finishTitle>\n\t  <finishText>Čestitamo! Završili ste instaliranje upravljačkih programa uređaja.</finishText>\n    </language>\n\n    <!-- Czech -->\n    <language code=\"0x0405\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Vítejte v průvodci instalací ovladače zařízení.</welcomeTitle>\n      <welcomeIntro>Tento průvodce vás provede procesem instalace softwarového ovladače, který je vyžadován pro využití všech funkcí vašeho hardwarového zařízení.</welcomeIntro>\n      <installHeaderTitle>Instalace softwaru pro vaše hardwarové zařízení...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Dokončení průvodce instalací ovladače zařízení.</finishTitle>\n\t  <finishText>Gratulujeme! Instalace ovladačů pro vaše zařízení byla úspěšně dokončena.</finishText>\n    </language>\n\n    <!--  Danish  --> \n    <language code=\"0x0406\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Velkommen til installationsguiden til enhedsdrivere.</welcomeTitle>\n      <welcomeIntro>Denne guider fører dig gennem installationsprocessen for den enhedsdriversoftware, du skal bruge for at få det fulde udbytte af din hardwareenheds funktioner.</welcomeIntro>\n      <installHeaderTitle>Softwaren til din hardwareenhed bliver installeret...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Fuldførelse af installationsguiden til enhedsdrivere</finishTitle>\n\t  <finishText>Tillykke. Du har fuldført installationen af dine enhedsdrivere.</finishText>\n    </language>\n\n    <!--  Finnish --> \n    <language code=\"0x040b\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Tervetuloa ohjattuun laiteajurin asennustoimintoon.</welcomeTitle>\n      <welcomeIntro>Tämä ohjattu toiminto opastaa asentamaan laiteajuriohjelmiston, jota tarvitaan, jotta laitteen toiminnot voidaan ottaa kokonaan käyttöön.</welcomeIntro>\n      <installHeaderTitle>Asennetaan laitteen ohjelmistoa...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Viimeistellään laiteajurin ohjattua asennustoimintoa</finishTitle>\n\t  <finishText>Onnittelut! Laiteajurit on asennettu.</finishText>\n    </language>\n\n    <!--  French --> \n    <language code=\"0x040c\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Bienvenue dans l'assistant d'installation du pilote de périphérique.</welcomeTitle>\n      <welcomeIntro>Cet assistant vous guidera tout au long du processus d'installation du logiciel du pilote de périphérique, nécessaire pour activer l'intégralité des fonctions de votre périphérique matériel.</welcomeIntro>\n      <installHeaderTitle>Installation du logiciel de votre périphérique matériel en cours…</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Terminer la procédure d'installation du pilote de périphérique de l'assistant</finishTitle>\n\t  <finishText>Félicitations ! Vous avez terminé d'installer vos pilotes de périphérique.</finishText>\n    </language>\n\n    <!-- Greek -->\n    <language code=\"0x0408\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Καλώς ορίσατε στον οδηγό εγκατάστασης προγραμμάτων οδήγησης συσκευών.</welcomeTitle>\n      <welcomeIntro>Αυτός ο οδηγός θα σας καθοδηγήσει στη διαδικασία εγκατάστασης του λογισμικού προγραμμάτων οδήγησης συσκευών που είναι απαραίτητο, ώστε να ενεργοποιηθούν πλήρως οι λειτουργίες της συσκευής υλικού σας.</welcomeIntro>\n      <installHeaderTitle>Εγκατάσταση του λογισμικού για τη συσκευή υλικού σας...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Ολοκλήρωση του οδηγού εγκατάστασης προγραμμάτων οδήγησης συσκευών</finishTitle>\n\t  <finishText>Συγχαρητήρια! Η εγκατάσταση των προγραμμάτων οδήγησης συσκευών ολοκληρώθηκε.</finishText>\n    </language>\n\n    <!--  German --> \n    <language code=\"0x0407\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Willkommen beim Installationsassistenten des Einheitentreibers.</welcomeTitle>\n      <welcomeIntro>Dieser Assistent führt Sie durch die Installation der Einheitentreibersoftware, die erforderlich ist, um die Funktionen Ihrer Hardwareeinheit vollständig zu aktivieren.</welcomeIntro>\n      <installHeaderTitle>Die Software für die Hardwareeinheit wird installiert ...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Der Installationsassistent für den Einheitentreiber wird beendet.</finishTitle>\n\t  <finishText>Herzlichen Glückwunsch! Sie haben die Einheitentreiber installiert.</finishText>\n    </language>\n\n    <!-- Hebrew -->\n    <language code=\"0x040d\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>ברוכים הבאים לאשף ההתקנה של מנהל ההתקן.</welcomeTitle>\n      <welcomeIntro>האשף ינחה אתכם בתהליך התקנת תוכנת מנהל ההתקן הנדרשת כדי להפעיל באופן מלא את הפונקציות של התקן החומרה שלכם.</welcomeIntro>\n      <installHeaderTitle>התקנת התוכנה עבור התקן החומרה שלכם...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>השלמת אשף ההתקנה של מנהל ההתקן</finishTitle>\n\t  <finishText>ברכותינו! סיימתם להתקין את מנהלי ההתקנים שלכם.</finishText>\n    </language>\n\n    <!-- Hungary -->\n    <language code=\"0x040e\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  <!-- Title elements -->\n      <welcomeTitle>Üdvözli az eszközillesztő-telepítő varázsló!</welcomeTitle>\n      <welcomeIntro>A varázsló végigvezeti a hardvere teljes körű működéséhez szükséges eszközillesztő szoftver telepítésének folyamatán.</welcomeIntro>\n      <installHeaderTitle>A hardverhez szükséges szoftver telepítése...</installHeaderTitle>\n\t  \n\t  <!-- Watermark bitmap that appears on the left side of welcome page and finish page -->\n\t  <watermarkPath>DpinstWaterMark.bmp</watermarkPath>\n  \n  \n      <finishTitle>Az eszközillesztő-telepítő varázsló befejezése</finishTitle>\n\t  <finishText>Gratulálunk! Az eszközillesztők telepítése kész.</finishText>\n    </language>\n\n    <!-- Indonesian -->\n    <language code=\"0x0421\">\n      <dpinstTitle>Energy Management Driver </dpinstTitle>\n\t  